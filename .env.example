# Development defaults. Set your own password before sharing the installation.
DB_NAME=unefa_medica
DB_USER=unefa_admin
DB_PASSWORD=unefa_secure_pass
APP_TIMEZONE=America/Caracas
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
# Administrador inicial (solo se crea si no existe ningún usuario). Valor de ejemplo
# exclusivo para desarrollo: use una contraseña propia de al menos 10 caracteres.
ADMIN_USER=admin
ADMIN_PASSWORD=cambie_esta_clave_dev
# 1 únicamente detrás de un proxy inverso de confianza que envíe X-Forwarded-Proto/Host.
TRUST_PROXY=0
